{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "GoTiny",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#booleans"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#variables"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.gt",
					"match": "#.*$"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.gt",
					"match": "\\b(if|else|return)\\b"
				},
				{
					"name": "keyword.other.declaration.gt",
					"match": "\\b(let|fn)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "entity.name.type.gt",
					"match": "\\b(Int|Bool)\\b"
				}
			]
		},
		"booleans": {
			"patterns": [
				{
					"name": "constant.language.boolean.gt",
					"match": "\\b(true|false)\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.gt",
					"match": "\\bfn\\s+([a-zA-Z_]\\w*)",
					"captures": {
						"1": {
							"name": "entity.name.function.gt"
						}
					}
				},
				{
					"name": "entity.name.function.gt",
					"match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.integer.gt",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.gt",
					"match": "(&&|\\|\\||==|!=|<=|>=|[<>+\\-*/!])"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other.readwrite.gt",
					"match": "\\b(?!(?:if|else|return|let|fn|Int|Bool|true|false)\\b)(?![a-zA-Z_]\\w*\\s*\\()[a-zA-Z_]\\w*\\b"
				}
			]
		}
	},
	"scopeName": "source.gt"
}